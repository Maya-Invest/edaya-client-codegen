{
	"name": "@edaya/client-codegen",
	"type": "module",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/Maya-Invest/edaya-client-codegen.git"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./contract": {
			"types": "./src/contract/index.ts",
			"import": "./src/contract/index.ts"
		}
	},
	"bin": {
		"edaya-codegen": "./bin/edaya-codegen.ts"
	},
	"scripts": {
		"test": "bun test test --dots",
		"check": "tsc --noEmit",
		"quality": "bun run check && bun run test"
	},
	"dependencies": {
		"openapi-typescript": "^7.13.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"typescript": "^6.0.2"
	}
}
